# auris environment template
# Copy to `.env` and fill in what you need. `.env` is git-ignored — never commit real keys.
# All defaults live in engine/config/*.py; only lines you want to override need to be uncommented.
#
# Minimal setup for the dubbing pipeline (video -> Chinese-dubbed mp4):
#   ASR  : local whisper by default (free, no key) — just works after `uv sync`
#   TTS  : edge-tts by default (free, no key)
#   LLM  : REQUIRED — any OpenAI-compatible endpoint (translation quality drives the dub)
#   Infra: `make infra-up` (MySQL/Redis/Kafka/Nacos + RustFS object storage, no keys needed)

# ===== LLM (required for dubbing translation) =====
# Any OpenAI-compatible endpoint works. Examples:
#   DeepSeek : https://api.deepseek.com          model: deepseek-chat
#   Dashscope: https://dashscope.aliyuncs.com/compatible-mode/v1   model: qwen-plus
#   Local    : http://127.0.0.1:28000/v1         model: Qwen3-4B-Instruct-2507-DDWQ (any local server)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# ===== ASR (optional — local whisper is the default, free and key-less) =====
# Provider: whisper (default, local) | qwen3 (OpenAI-compatible server, e.g. omlx) | qas (DashScope streaming)
# ASR_PROVIDER=whisper
# ASR_MODEL=medium            # tiny/base/small/medium/large-v3
# ASR_COMPUTE=int8
# ASR_LANG=                   # empty = auto-detect source language (recommended for dubbing)

# --- Option B: qwen3-ASR via an OpenAI-compatible local server (faster on Apple Silicon with omlx) ---
# ASR_PROVIDER=qwen3
# ASR_QWEN3_BASE_URL=http://127.0.0.1:28000/v1
# ASR_QWEN3_API_KEY=123456
# ASR_QWEN3_MODEL=Qwen3-ASR-1.7B-4bit

# --- Option C: qwen-audio streaming via DashScope (cloud, paid) ---
# ASR_PROVIDER=qas
# ASR_QAS_API_KEY=sk-your-dashscope-key
# ASR_QAS_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# ASR_QAS_MODEL=qwen-audio-3.0-asr-flash-streaming

# ===== TTS (optional — edge-tts is the default, free, no key) =====
# TTS_PROVIDER=edge_tts
# TTS_VOICE=zh-CN-XiaoxiaoNeural

# ===== Object storage (RustFS, docker compose service — defaults match compose.yaml) =====
RUSTFS_ENDPOINT=http://localhost:9100
RUSTFS_ACCESS_KEY=auris
RUSTFS_SECRET_KEY=auris-secret
RUSTFS_BUCKET=auris-dubbing
PRESIGN_EXPIRE_S=900

# ===== Local test account (optional; create via the register page or see README) =====
AURIS_TEST_USER=
AURIS_TEST_PASSWORD=

# ===== Server-side overrides (dev defaults already in application.yaml — override for prod) =====
# JWT_ACCESS_SECRET=change-me-in-prod
# BYOK_MASTER_KEY=            # base64 of 32 bytes; generates one via: openssl rand -base64 32

# ===== Engine basics (rarely changed) =====
# PORT=18000
# HOST=127.0.0.1
# DEBUG=false

# ===== Dubbing pipeline tuning (defaults are sensible; see docs for details) =====
# DUB_TASK_TTL_H=24           # artifact retention (hours)
# ASR_SEG_TARGET_MAX_S=15     # long-audio segment length
# DUB_CPS=4.5                 # Chinese speech rate (chars/sec) for alignment
