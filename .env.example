# 复制为 .env 后按需修改;.env 不提交 git
# 所有默认值见 engine/config.py,这里只列需要覆盖时才写的项

# ===== 服务 =====
# PORT=18000
# HOST=127.0.0.1
# DEBUG=false

# ===== ASR =====
# ASR_PROVIDER=whisper
# ASR_MODEL=medium
# ASR_DEVICE=auto        # Mac M 芯片实际落到 cpu
# ASR_COMPUTE=int8
# ASR_LANG=zh
# ASR_SAMPLE_RATE=16000
# 流式 VAD(silero-vad)
# ASR_VAD_THRESHOLD=0.5
# ASR_VAD_MIN_SILENCE_MS=300
# ASR_VAD_SPEECH_PAD_MS=30
